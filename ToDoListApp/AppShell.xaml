<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ToDoListApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ToDoListApp"
    xmlns:pages="clr-namespace:ToDoListApp.Pages"
    Title="ToDoListApp">

    <TabBar>
        <ShellContent
            Title="To Do"
            ContentTemplate="{DataTemplate pages:ToDoListPage}"
            Route="ToDoListPage" />
        <ShellContent
            Title="Completed"
            ContentTemplate="{DataTemplate pages:CompletedToDoPage}"
            Route="CompletedToDoPage" />
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>

</Shell>
