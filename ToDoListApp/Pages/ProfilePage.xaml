<ContentPage
    x:Class="ToDoListApp.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile">

    <VerticalStackLayout
        Padding="30"
        HorizontalOptions="Center"
        Spacing="20">

        <Image
            HeightRequest="120"
            Source="default_pfp_yellow.png"
            WidthRequest="120" />

        <Label
            FontAttributes="Bold"
            FontSize="30"
            HorizontalOptions="Center"
            Text="Profile" />

        <Label FontAttributes="Bold" Text="Username:" />

        <Label x:Name="UsernameLabel" FontSize="18" />

        <Label FontAttributes="Bold" Text="Email:" />

        <Label x:Name="EmailLabel" FontSize="18" />

        <Button
            Margin="0,20,0,0"
            BackgroundColor="Red"
            Clicked="Logout_Clicked"
            Text="Log Out"
            TextColor="White" />

    </VerticalStackLayout>

</ContentPage>