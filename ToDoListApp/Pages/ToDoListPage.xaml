<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ToDoListApp.Pages.ToDoListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ToDo">
    <Grid
        ColumnDefinitions="*,*,*,*"
        RowDefinitions=" 10*, 90*"
        RowSpacing="15">

        <!--  THIS IS THE MAIN PAGE, it displays the to do list  -->
        <Image
            Grid.Row="0"
            Grid.Column="0"
            Aspect="AspectFit"
            Source="default_pfp_yellow.png" />

        <Label
            Grid.Row="0"
            Grid.Column="1"
            FontSize="30"
            HorizontalOptions="Center"
            Text="Hi!"
            VerticalOptions="Center" />
        <Label
            x:Name="username"
            Grid.Row="0"
            Grid.Column="2"
            FontSize="30"
            Text="User"
            VerticalOptions="Center" />

        <Button
            x:Name="goToAddToDoPage"
            Grid.Row="1"
            Grid.Column="3"
            VerticalOptions="End"
            HorizontalOptions="End"
            BackgroundColor="white"
            BorderColor="black"
            BorderWidth="3"
            Clicked="goToAddToDoPage_Clicked"
            CornerRadius="30"
            FontSize="20"
            HeightRequest="50"
            Text="+"
            TextColor="Black"
            WidthRequest="50" 
            ZIndex="10"
            Margin="0,0,40,0"/>
        <!--  this is the Listview that is data bound to the observable collection  -->
        <ListView
            x:Name="taskView"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            BackgroundColor="white"
            ItemSelected="taskView_ItemSelected"
            RowHeight="100"
            SeparatorColor="Black">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Border
                            Stroke="orange"
                            StrokeShape="RoundRectangle 5"
                            StrokeThickness="2">
                            <Grid
                                Margin="0,0,0,10"
                                ColumnDefinitions="*,Auto,Auto"
                                RowDefinitions="*,*">

                                <BoxView
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    BackgroundColor="Orange" />
                                <!--  Task Title  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    Text="{Binding Title}"
                                    TextColor="white" 
                                    FontSize="20"/>

                                <!--  Task Detail  -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Detail}"
                                    TextColor="Gray"
                                    FontSize="15"/>
                                <!--  Delete Button  -->

                                <Button
                                    x:Name="DeleteItemButton"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    BackgroundColor="transparent"
                                    Clicked="Delete_Clicked"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="55"
                                    ImageSource="delete_icon_2.png"
                                    TextColor="White"
                                    WidthRequest="55" />
                                <!--  Complete Button  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Margin="5"
                                    BackgroundColor="Transparent"
                                    Clicked="Complete_Clicked"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="55"
                                    ImageSource="check_icon_2.png"
                                    WidthRequest="55"/>
                            </Grid>
                        </Border>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


    </Grid>
</ContentPage>