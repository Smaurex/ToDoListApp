<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ToDoListApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--  SIGN UP PAGE  -->

    <Grid RowDefinitions="50*,*,*,*,*">
        <Image
            Grid.Row="0"
            Aspect="AspectFit"
            Source="todo.png" />

        <Entry
            x:Name="Email"
            Grid.Row="2"
            Placeholder="Email" />
        <Entry
            x:Name="Password"
            Grid.Row="2"
            Placeholder="Password" />



    </Grid>

</ContentPage>
